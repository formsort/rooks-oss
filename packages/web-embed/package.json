{
  "name": "@rooks-ai/web-embed",
  "version": "0.3.0",
  "description": "Embed Rooks forms in web pages",
  "keywords": [
    "embed",
    "forms",
    "rooks"
  ],
  "homepage": "https://github.com/formsort/rooks-oss/tree/main/packages/web-embed#readme",
  "bugs": "https://github.com/formsort/rooks-oss/issues",
  "license": "MIT",
  "author": "Formsort Engineering <engineering@formsort.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formsort/rooks-oss.git",
    "directory": "packages/web-embed"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rm -rf dist && vite build && tsc -p tsconfig.build.json && node scripts/cjs-types.js",
    "typecheck": "tsc",
    "test": "vitest run",
    "check:package": "publint --strict && attw --pack --profile node16 && node --input-type=module -e \"await import('./dist/index.js')\" && node -e \"require('./dist/index.cjs')\""
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "^1.65.1",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
